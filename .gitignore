# ------------------------------
# C/C++ 编译产物
# ------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.d
*.gcda
*.gcno
*.gcov

# 可执行/测试产物（如果你的可执行文件名固定，也可按需加更具体的）
test_*

# ------------------------------
# CMake / 构建目录（不提交生成物）
# ------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt

# CMake File API / IDE 集成生成
.cmake/

# clangd / 编译数据库
compile_commands.json

# ------------------------------
# 生成的库/发布目录（如需提交 lib 源码，请改为更具体的忽略规则）
# ------------------------------
lib/*.so
lib/*.so.*
lib/*.a
lib/*.dylib

# ------------------------------
# IDE / 编辑器
# ------------------------------
.vscode/
.idea/
.vs/
*.code-workspace

# ------------------------------
# 临时文件/系统文件
# ------------------------------
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# 崩溃转储
core
core.*

# ------------------------------
# 日志
# ------------------------------
*.log
logs/
